# --- WAHA ---
WAHA_BASE_URL=https://whatsapp-auto.ximplify.id
WAHA_API_KEY=            # paste the WAHA x-api-key here (required)
WAHA_SESSION=default
GROUP_CHAT_ID=           # leave empty on first run to list groups, then paste the <id>@g.us
TRIGGER_PREFIX=@bot
POLL_INTERVAL=4
HISTORY_LIMIT=20
REPLY_PREFIX=🤖

# --- LLM (OpenAI-compatible; default = OpenRouter) ---
# Swap base URL + model for any OpenAI-compatible provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=            # paste OpenRouter key (sk-or-...)
LLM_MODEL=openai/gpt-4o-mini
SYSTEM_PROMPT=You are a helpful assistant replying inside a WhatsApp group chat. Keep answers short and plain-text (no markdown). You can call tools when useful.

# --- Tools ---
# Tavily web search (https://tavily.com) -- enables the web_search tool.
TAVILY_API_KEY=

# --- Mode ---
# BOT_MODE=poll (default) or webhook. Webhook needs a public URL WAHA can POST to:
BOT_MODE=poll
# PUBLIC_WEBHOOK_URL=https://your-public-host   # required only for BOT_MODE=webhook
# WEBHOOK_PORT=8080
# WEBHOOK_EVENTS=message.any

# --- Self-hosted WAHA (docker-compose) ---
# For your own WAHA, session can simply be "default".
# WAHA_SESSION=default
WHATSAPP_DEFAULT_ENGINE=GOWS

# --- Shared wedding doc (self-hosted) ---
DOC_TOKEN=            # secret in the doc URL; generate with: openssl rand -hex 16
DOC_PUBLIC_BASE=      # public base the couple opens, e.g. http://<server-ip>:8080
DOC_TITLE=Wedding Plan
# DOC_PATH=/data/wedding.md
# PLAN_PATH=/data/plan.json   # income/expense ledger + notes (JSON)
