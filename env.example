# --- WAHA ---
WAHA_BASE_URL=https://whatsapp-auto.ximplify.id
WAHA_API_KEY=            # paste the WAHA x-api-key here (required)
WAHA_SESSION=default
GROUP_CHAT_ID=           # leave empty on first run to list groups, then paste the <id>@g.us
TRIGGER_PREFIX=@bot
POLL_INTERVAL=4
HISTORY_LIMIT=20
REPLY_PREFIX=🤖

# --- LLM (OpenAI-compatible; default = OpenRouter) ---
# Swap base URL + model for any OpenAI-compatible provider.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=            # paste OpenRouter key (sk-or-...)
LLM_MODEL=openai/gpt-4o-mini
SYSTEM_PROMPT=You are a helpful assistant replying inside a WhatsApp group chat. Keep answers short and plain-text (no markdown). You can call tools when useful.

# --- Tools ---
# Tavily web search (https://tavily.com) -- enables the web_search tool.
TAVILY_API_KEY=

# --- Mode ---
# BOT_MODE=poll (default) or webhook. Webhook needs a public URL WAHA can POST to:
BOT_MODE=poll
# PUBLIC_WEBHOOK_URL=https://your-public-host   # required only for BOT_MODE=webhook
# WEBHOOK_PORT=8080
# WEBHOOK_EVENTS=message.any

# --- Self-hosted WAHA (docker-compose) ---
# For your own WAHA, session can simply be "default".
# WAHA_SESSION=default
WHATSAPP_DEFAULT_ENGINE=GOWS

# --- Shared wedding doc (self-hosted) ---
DOC_TOKEN=            # secret in the doc URL; generate with: openssl rand -hex 16
DOC_PUBLIC_BASE=      # public base the couple opens, e.g. http://<server-ip>:8080
DOC_TITLE=Wedding Plan
# DOC_PATH=/data/wedding.md
# PLAN_PATH=/data/plan.json   # income/expense ledger + notes (JSON)

# --- Model switching (via `@bang /model ...`) ---
MODEL_CHOICES=openai/gpt-5.4-mini,openai/gpt-5.4
# MAX_IMAGE_BYTES=4194304

# --- Observability (optional; everything no-ops when unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Email reminders (Brevo) ---
# A to-do is mailed about `REMIND_DEFAULT_LEAD` before its due date, unless the
# to-do itself overrides the lead or the recipients. Leave BREVO_API_KEY empty
# to turn the whole thing off.
# Transport -- set EITHER the API key (preferred: HTTPS/443, never blocked)
# OR the SMTP relay login below. Set both and the API is used, with SMTP as a
# fallback. Hetzner blocks outbound 25/465/587 on new accounts, so if SMTP
# times out, that is why -- ask Hetzner to unblock, or just use the API key.
BREVO_API_KEY=                      # Brevo v3 API key, starts with xkeysib-
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=86dee1001@smtp-brevo.com
SMTP_PASSWORD=                      # the Brevo SMTP key, NOT your account password
MAIL_FROM_EMAIL=                    # sender address -- must be a VERIFIED sender in Brevo
MAIL_FROM_NAME=Wedding Planner
MAIL_PEOPLE=                        # address book: rahmat:you@mail.com,dian:dian@mail.com
MAIL_TO_DEFAULT=                    # who gets reminders when a to-do names nobody, e.g. rahmat,dian
REMIND_DEFAULT_LEAD=1d              # 15m / 30m / 1h / 3h / 1d / 2d / 1w  ("off" = never)
REMIND_DEFAULT_TIME=09:00           # assumed time of day for a to-do with a date but no time
REMIND_POLL_SECONDS=60              # how often the scheduler checks
REMIND_ENABLED=true                 # false kills reminders without unsetting the key
TIMEZONE=Asia/Jakarta               # the zone due dates are written in
